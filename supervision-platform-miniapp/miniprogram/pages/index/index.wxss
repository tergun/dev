.container {
  padding: 40rpx;
}

.title {
  font-size: 36rpx;
  font-weight: bold;
  text-align: center;
  margin-bottom: 60rpx;
}

.menu {
  display: flex;
  flex-direction: column;
  gap: 32rpx;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 32rpx;
  background-color: #ffffff;
  border-radius: var(--border-radius);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.menu-icon {
  width: 48rpx;
  height: 48rpx;
  margin-right: 24rpx;
}
