.card-title {
  font-size: var(--font-size-lg);
  font-weight: bold;
  margin-bottom: 32rpx;
}

.step-indicator {
  display: flex;
  justify-content: center;
  margin-bottom: 48rpx;
  gap: 32rpx;
}

.step {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background-color: #f0f0f0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--font-size-base);
  color: #999999;
}

.step.active {
  background-color: var(--primary-color);
  color: #ffffff;
}

.step-content {
  margin-top: 32rpx;
}
