.container {
  padding: 32rpx;
}

.update-info {
  background-color: #ffffff;
  border-radius: var(--border-radius);
  padding: 24rpx;
  margin-bottom: 32rpx;
}

.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 32rpx;
}

.title {
  font-size: var(--font-size-lg);
  font-weight: bold;
}

.date {
  font-size: var(--font-size-sm);
  color: #666666;
}

.form {
  margin-bottom: 32rpx;
}

.form-item {
  margin-bottom: 24rpx;
}

.label {
  display: block;
  font-size: var(--font-size-base);
  margin-bottom: 16rpx;
}

.textarea {
  width: 100%;
  height: 200rpx;
  padding: 16rpx;
  background-color: #f5f5f5;
  border-radius: var(--border-radius);
  box-sizing: border-box;
}

.button-group {
  display: flex;
  justify-content: flex-end;
}

.update-history {
  background-color: #ffffff;
  border-radius: var(--border-radius);
  padding: 24rpx;
}

.section-title {
  font-size: var(--font-size-lg);
  font-weight: bold;
  margin-bottom: 24rpx;
}

.history-list {
  margin-top: 16rpx;
}

.history-item {
  padding: 24rpx;
  background-color: #f5f5f5;
  border-radius: var(--border-radius);
  margin-bottom: 16rpx;
}

.history-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.history-date {
  font-size: var(--font-size-sm);
  color: #666666;
}

.history-percentage {
  font-size: var(--font-size-sm);
  color: var(--primary-color);
}

.history-content {
  font-size: var(--font-size-base);
  color: #333333;
  line-height: 1.5;
}
