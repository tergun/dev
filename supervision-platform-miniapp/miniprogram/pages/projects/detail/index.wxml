<view class="container">
  <view class="basic-info card">
    <view class="section-title">基本信息</view>
    <view class="info-grid">
      <view class="info-item">
        <text class="label">项目名称</text>
        <text class="value">{{project.name}}</text>
      </view>
      <view class="info-item">
        <text class="label">分管领导</text>
        <text class="value">{{project.supervisor}}</text>
      </view>
      <view class="info-item">
        <text class="label">责任单位</text>
        <text class="value">{{project.responsibleUnit}}</text>
      </view>
      <view class="info-item">
        <text class="label">开始日期</text>
        <text class="value">{{project.startDate}}</text>
      </view>
      <view class="info-item">
        <text class="label">结束日期</text>
        <text class="value">{{project.endDate}}</text>
      </view>
      <view class="info-item">
        <text class="label">项目状态</text>
        <text class="value status {{project.status}}">{{statusText}}</text>
      </view>
    </view>
  </view>

  <view class="approval-stages card">
    <view class="section-title">前期手续办理</view>
    <view class="stage-list">
      <view class="stage-item" wx:for="{{stages}}" wx:key="id">
        <view class="stage-header">
          <text class="stage-name">{{item.name}}</text>
          <text class="stage-status {{item.status}}">{{item.statusText}}</text>
        </view>
        <view class="stage-content" wx:if="{{item.status !== 'APPROVED'}}">
          <view class="stage-field">
            <text class="field-label">办理期限</text>
            <text class="field-value">{{item.deadline || '未设置'}}</text>
          </view>
          <view class="stage-field">
            <text class="field-label">办理层级</text>
            <text class="field-value">{{item.level || '未设置'}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <view class="progress card">
    <view class="section-title">项目进展</view>
    <view class="progress-content">
      <view class="progress-bar">
        <view class="progress-inner" style="width: {{project.visualPercentage}}%"></view>
      </view>
      <text class="progress-text">形象进度：{{project.visualPercentage}}%</text>
      <view class="progress-update">
        <text class="update-time">最后更新：{{project.lastUpdated}}</text>
        <text class="update-status" wx:if="{{project.needsUpdate}}">需要更新内容</text>
      </view>
    </view>
  </view>
</view>
