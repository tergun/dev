.container {
  padding: 32rpx;
}

.card {
  background-color: #ffffff;
  border-radius: var(--border-radius);
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: var(--font-size-lg);
  font-weight: bold;
  margin-bottom: 24rpx;
}

.info-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
}

.info-item {
  padding: 16rpx;
  background-color: #f5f5f5;
  border-radius: var(--border-radius);
}

.label {
  display: block;
  font-size: var(--font-size-sm);
  color: #666666;
  margin-bottom: 8rpx;
}

.value {
  font-size: var(--font-size-base);
  color: #333333;
}

.status {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: 32rpx;
  font-size: var(--font-size-sm);
}

.status.NOT_STARTED {
  background-color: #f5f5f5;
  color: #666666;
}

.status.IN_PROGRESS {
  background-color: #e6f7ff;
  color: var(--primary-color);
}

.status.COMPLETED {
  background-color: #f6ffed;
  color: var(--success-color);
}

.status.SUSPENDED {
  background-color: #fff2e8;
  color: var(--warning-color);
}

.stage-list {
  margin-top: 16rpx;
}

.stage-item {
  background-color: #f5f5f5;
  border-radius: var(--border-radius);
  padding: 24rpx;
  margin-bottom: 16rpx;
}

.stage-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.stage-name {
  font-size: var(--font-size-base);
  font-weight: bold;
}

.stage-status {
  padding: 4rpx 16rpx;
  border-radius: 32rpx;
  font-size: var(--font-size-sm);
}

.stage-status.PENDING {
  background-color: #f5f5f5;
  color: #666666;
}

.stage-status.IN_PROGRESS {
  background-color: #e6f7ff;
  color: var(--primary-color);
}

.stage-status.APPROVED {
  background-color: #f6ffed;
  color: var(--success-color);
}

.stage-status.REJECTED {
  background-color: #fff1f0;
  color: var(--error-color);
}

.stage-content {
  margin-top: 16rpx;
}

.stage-field {
  margin-bottom: 8rpx;
}

.field-label {
  font-size: var(--font-size-sm);
  color: #666666;
  margin-right: 16rpx;
}

.field-value {
  font-size: var(--font-size-base);
  color: #333333;
}

.progress-bar {
  height: 16rpx;
  background-color: #f5f5f5;
  border-radius: 8rpx;
  overflow: hidden;
  margin-bottom: 8rpx;
}

.progress-inner {
  height: 100%;
  background-color: var(--primary-color);
  transition: width 0.3s ease;
}

.progress-text {
  font-size: var(--font-size-base);
  color: #333333;
  margin-bottom: 16rpx;
}

.progress-update {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.update-time {
  font-size: var(--font-size-sm);
  color: #666666;
}

.update-status {
  color: var(--error-color);
  font-size: var(--font-size-sm);
}
