.project-card {
  background-color: #ffffff;
  border-radius: var(--border-radius);
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.title {
  font-size: var(--font-size-lg);
  font-weight: bold;
}

.status {
  padding: 8rpx 16rpx;
  border-radius: 32rpx;
  font-size: var(--font-size-sm);
}

.status.NOT_STARTED {
  background-color: #f5f5f5;
  color: #666666;
}

.status.IN_PROGRESS {
  background-color: #e6f7ff;
  color: var(--primary-color);
}

.status.COMPLETED {
  background-color: #f6ffed;
  color: var(--success-color);
}

.status.SUSPENDED {
  background-color: #fff2e8;
  color: var(--warning-color);
}

.info {
  margin-bottom: 24rpx;
}

.info-item {
  display: flex;
  margin-bottom: 8rpx;
}

.label {
  color: #666666;
  width: 160rpx;
}

.value {
  flex: 1;
}

.progress {
  margin-bottom: 16rpx;
}

.progress-bar {
  height: 16rpx;
  background-color: #f5f5f5;
  border-radius: 8rpx;
  overflow: hidden;
  margin-bottom: 8rpx;
}

.progress-inner {
  height: 100%;
  background-color: var(--primary-color);
  transition: width 0.3s ease;
}

.progress-text {
  font-size: var(--font-size-sm);
  color: #666666;
}

.update-status {
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 2rpx solid #f5f5f5;
}

.warning {
  color: var(--error-color);
  font-size: var(--font-size-sm);
}
