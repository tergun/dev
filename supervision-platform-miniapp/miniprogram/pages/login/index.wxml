<!-- 头部Logo -->
<view class="login-container">
  <view class="logo-container">
    <image class="logo" src="/static/logo.png" mode="aspectFit"></image>
  </view>
  
  <!-- 登录/注册标题 -->
  <view class="title">登录/注册</view>
  
  <!-- 表单区域 -->
  <view class="form-container">
    <!-- 账号输入框 -->
    <view class="input-item">
      <input 
        type="text" 
        model:value="{{formData.account}}" 
        placeholder="账号" 
        placeholder-class="placeholder"
      />
    </view>
    
    <!-- 密码输入框 -->
    <view class="input-item">
      <input 
        type="password" 
        model:value="{{formData.password}}" 
        placeholder="密码" 
        placeholder-class="placeholder"
      />
    </view>
    
    <!-- 登录按钮 -->
    <button class="login-btn" bindtap="handleLogin">获取验证码</button>
    
    <!-- 用户协议 -->
    <view class="agreement">
      <text class="agreement-text">注册即表示同意</text>
      <text class="link">《用户服务协议》</text>
      <text class="agreement-text">和</text>
      <text class="link">《隐私政策》</text>
    </view>
  </view>
  
  <!-- 第三方登录 -->
  <view class="third-party">
    <view class="third-party-title">第三方登录</view>
    <view class="third-party-icons">
      <view class="icon-item">
        <text class="iconfont icon-grid"></text>
      </view>
      <view class="icon-item">
        <text class="iconfont icon-discover"></text>
      </view>
      <view class="icon-item">
        <text class="iconfont icon-message"></text>
      </view>
    </view>
  </view>
</view>
