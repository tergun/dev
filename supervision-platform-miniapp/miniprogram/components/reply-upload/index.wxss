.reply-upload {
  width: 100%;
}

.upload-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 320rpx;
  background-color: #fafafa;
  border: 2rpx dashed var(--border-color);
  border-radius: var(--border-radius);
}

.upload-icon {
  width: 96rpx;
  height: 96rpx;
  margin-bottom: 16rpx;
}

.upload-icon image {
  width: 100%;
  height: 100%;
}

.upload-text {
  font-size: var(--font-size-base);
  color: var(--primary-color);
  margin-bottom: 8rpx;
}

.upload-desc {
  font-size: var(--font-size-sm);
  color: #999999;
}

.file-info {
  margin-top: 32rpx;
  padding: 24rpx;
  background-color: #ffffff;
  border-radius: var(--border-radius);
  display: flex;
  align-items: center;
}

.file-icon {
  width: 64rpx;
  height: 64rpx;
  margin-right: 16rpx;
}

.file-icon image {
  width: 100%;
  height: 100%;
}

.file-details {
  flex: 1;
}

.file-name {
  display: block;
  font-size: var(--font-size-base);
  color: #333333;
  margin-bottom: 4rpx;
}

.file-size {
  display: block;
  font-size: var(--font-size-sm);
  color: #999999;
}

.button-group {
  display: flex;
  justify-content: flex-end;
  margin-top: 32rpx;
  gap: 16rpx;
}
