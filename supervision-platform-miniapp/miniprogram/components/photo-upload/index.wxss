.photo-upload {
  width: 100%;
}

.upload-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 320rpx;
  background-color: #fafafa;
  border: 2rpx dashed var(--border-color);
  border-radius: var(--border-radius);
}

.upload-icon {
  width: 96rpx;
  height: 96rpx;
  margin-bottom: 16rpx;
}

.upload-icon image {
  width: 100%;
  height: 100%;
}

.upload-text {
  font-size: var(--font-size-base);
  color: var(--primary-color);
}

.photo-info {
  margin-top: 32rpx;
  background-color: #ffffff;
  border-radius: var(--border-radius);
  padding: 24rpx;
}

.preview {
  width: 100%;
  height: 400rpx;
  margin-bottom: 24rpx;
}

.preview image {
  width: 100%;
  height: 100%;
  border-radius: var(--border-radius);
}

.info-form {
  margin-bottom: 24rpx;
}

.form-item {
  margin-bottom: 16rpx;
}

.label {
  display: block;
  font-size: var(--font-size-base);
  margin-bottom: 8rpx;
}

.picker, .input {
  width: 100%;
  height: 80rpx;
  background-color: #f5f5f5;
  border-radius: var(--border-radius);
  padding: 0 24rpx;
  font-size: var(--font-size-base);
  line-height: 80rpx;
}

.button-group {
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
}

.photo-list {
  margin-top: 32rpx;
}

.section-title {
  font-size: var(--font-size-base);
  font-weight: bold;
  margin-bottom: 16rpx;
}

.grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
}

.photo-item {
  background-color: #ffffff;
  border-radius: var(--border-radius);
  overflow: hidden;
}

.photo-item image {
  width: 100%;
  height: 320rpx;
  object-fit: cover;
}

.photo-details {
  padding: 16rpx;
}

.photo-details text {
  display: block;
  font-size: var(--font-size-sm);
  color: #666666;
  margin-bottom: 4rpx;
}
