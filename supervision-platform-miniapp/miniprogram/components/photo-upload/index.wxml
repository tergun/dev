<view class="photo-upload">
  <view class="upload-area" bindtap="chooseImage">
    <view class="upload-icon">
      <image src="/assets/icons/camera.png" mode="aspectFit"></image>
    </view>
    <view class="upload-text">点击上传照片</view>
  </view>

  <block wx:if="{{currentPhoto}}">
    <view class="photo-info">
      <view class="preview">
        <image src="{{currentPhoto.path}}" mode="aspectFit"></image>
      </view>
      <view class="info-form">
        <view class="form-item">
          <text class="label">拍摄日期</text>
          <picker mode="date" value="{{currentPhoto.date}}" bindchange="onDateChange">
            <view class="picker">{{currentPhoto.date || '请选择日期'}}</view>
          </picker>
        </view>
        <view class="form-item">
          <text class="label">拍摄地点</text>
          <input 
            class="input" 
            value="{{currentPhoto.location}}" 
            bindinput="onLocationInput"
            placeholder="请输入拍摄地点"
          />
        </view>
      </view>
      <view class="button-group">
        <button class="button button-outline" bindtap="cancelUpload">取消</button>
        <button 
          class="button" 
          bindtap="confirmUpload"
          disabled="{{!currentPhoto.date || !currentPhoto.location}}"
        >
          确认上传
        </button>
      </view>
    </view>
  </block>

  <view class="photo-list" wx:if="{{photos.length > 0}}">
    <view class="section-title">已上传的照片</view>
    <view class="grid">
      <view class="photo-item" wx:for="{{photos}}" wx:key="path">
        <image src="{{item.path}}" mode="aspectFill"></image>
        <view class="photo-details">
          <text>日期：{{item.date}}</text>
          <text>地点：{{item.location}}</text>
        </view>
      </view>
    </view>
  </view>
</view>
